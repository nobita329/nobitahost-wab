<%- include('../../partials/head', { title: 'Links' }) %>

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-head"><h2><svg class="ic"><use href="#i-link"/></svg> Links</h2></div>
      <div class="card-body content-area"><%- page.content %></div>
    </div>
  </div>
</div>

<% if (isAdmin) { %>
<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-head">
        <h2><svg class="ic"><use href="#i-pencil"/></svg> Manage Links</h2>
        <button class="btn btn-accent btn-sm" type="button" id="linkAddBtn"><svg class="ic"><use href="#i-plus"/></svg> Add Link</button>
      </div>
      <div class="card-body">
        <% if (query && query.saved) { %><div class="alert alert-success">Link saved.</div><% } %>
        <% if (query && query.deleted) { %><div class="alert alert-success">Link deleted.</div><% } %>
        <% if (query && query.error === 'title') { %><div class="alert alert-error">Title is required.</div><% } %>
        <form method="POST" action="/links/add" class="form" id="linkAddForm" hidden>
          <div class="form-row">
            <div class="field"><label>Title</label><input type="text" name="title" required placeholder="e.g. GitHub"></div>
            <div class="field"><label>URL</label><input type="url" name="url" placeholder="https://…"></div>
          </div>
          <div class="field"><label>3D Icon <small>(pick any)</small></label>
            <input type="hidden" name="icon" id="linkIcon" value="🔗">
            <div class="icon-picker" data-target="linkIcon">
              <% icons.forEach(function(ic){ %>
              <button type="button" class="icon-opt" data-icon="<%= ic %>"><%= ic %></button>
              <% }); %>
            </div>
          </div>
          <button class="btn btn-accent" type="submit">Save Link</button>
        </form>
      </div>
    </div>
  </div>
</div>
<% } %>

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-head"><h2><svg class="ic"><use href="#i-link"/></svg> Quick Access</h2></div>
      <div class="card-body">
        <div class="link-grid">
          <% (links || []).forEach(function(l){ %>
          <div class="link-card-wrap">
            <a class="link-card" href="<%= l.url %>" target="_blank" rel="noopener">
              <div class="link-tile"><%= l.icon %></div>
              <div class="link-meta">
                <h3><%= l.title %></h3>
                <span class="link-url"><%= l.url || '#' %></span>
              </div>
              <svg class="ic link-arrow"><use href="#i-chevron-right"/></svg>
            </a>
            <% if (isAdmin) { %>
            <div class="link-actions">
              <button class="icon-btn" type="button" data-toggle-edit="<%= l.id %>" title="Edit"><svg class="ic"><use href="#i-pencil"/></svg></button>
              <form method="POST" action="/links/<%= l.id %>/delete" onsubmit="return confirm('Delete this link?')">
                <button class="icon-btn danger" type="submit" title="Delete"><svg class="ic"><use href="#i-trash"/></svg></button>
              </form>
            </div>
            <form method="POST" action="/links/<%= l.id %>/edit" class="link-edit" id="linkEdit-<%= l.id %>" hidden>
              <div class="form-row">
                <div class="field"><label>Title</label><input type="text" name="title" value="<%= l.title %>"></div>
                <div class="field"><label>URL</label><input type="url" name="url" value="<%= l.url %>"></div>
              </div>
              <div class="field"><label>3D Icon</label>
                <input type="hidden" name="icon" id="linkIcon-<%= l.id %>" value="<%= l.icon %>">
                <div class="icon-picker" data-target="linkIcon-<%= l.id %>">
                  <% icons.forEach(function(ic){ %>
                  <button type="button" class="icon-opt" data-icon="<%= ic %>"><%= ic %></button>
                  <% }); %>
                </div>
              </div>
              <button class="btn btn-accent btn-sm" type="submit">Save</button>
              <button class="btn btn-ghost btn-sm" type="button" data-toggle-edit="<%= l.id %>">Cancel</button>
            </form>
            <% } %>
          </div>
          <% }); %>
        </div>
        <% if (!links || !links.length) { %>
        <div class="empty">No links yet. <% if (isAdmin) { %>Click <b>Add Link</b> above to create one.<% } else { %>Check back soon.<% } %></div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
