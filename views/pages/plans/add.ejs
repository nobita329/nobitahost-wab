<%- include('../../partials/head', { title: editing ? 'Edit Plan' : 'Add Plan' }) %>

<% if (query && query.error) { %><div class="alert alert-error"><%= query.error %></div><% } %>

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-head">
        <h2><svg class="ic"><use href="#i-plus"/></svg> <%= editing ? 'Edit Plan' : 'Add New Plan' %></h2>
        <a class="btn btn-ghost btn-sm" href="/plans/all">Back to Plans</a>
      </div>
      <div class="card-body">
        <form method="POST" action="<%= editing ? '/plans/' + editing.id + '/edit' : '/plans/add' %>" class="form">
          <div class="form-row">
            <div class="field"><label>Plan Name *</label><input type="text" name="name" value="<%= editing ? editing.name : '' %>" required placeholder="e.g. Pro Plan"></div>
            <div class="field"><label>Category</label>
              <select name="category_id">
                <option value="">None</option>
                <% categories.forEach(function(c){ %>
                <option value="<%= c.id %>" <%= editing && editing.category_id == c.id ? 'selected' : '' %>><%= c.name %></option>
                <% }); %>
              </select>
            </div>
          </div>
          <div class="field"><label>Description</label><textarea name="description" rows="3" placeholder="Plan description"><%= editing ? editing.description : '' %></textarea></div>
          <div class="form-row">
            <div class="field"><label>Price *</label><input type="number" step="0.01" name="price" value="<%= editing ? editing.price : '0' %>" required placeholder="0.00"></div>
            <div class="field"><label>Billing Cycle</label>
              <select name="billing">
                <option value="monthly" <%= editing && editing.billing === 'monthly' ? 'selected' : '' %>>Monthly</option>
                <option value="yearly" <%= editing && editing.billing === 'yearly' ? 'selected' : '' %>>Yearly</option>
                <option value="lifetime" <%= editing && editing.billing === 'lifetime' ? 'selected' : '' %>>Lifetime</option>
              </select>
            </div>
          </div>
          <div class="field"><label>Features <small>(one per line)</small></label><textarea name="features" rows="6" placeholder="Feature 1&#10;Feature 2&#10;Feature 3"><%= editing ? editing.features : '' %></textarea></div>
          <div class="form-row">
            <div class="field"><label>Storage Limit</label><input type="text" name="storage_limit" value="<%= editing ? editing.storage_limit : '' %>" placeholder="e.g. 10GB"></div>
            <div class="field"><label>User Limit</label><input type="number" name="user_limit" value="<%= editing ? editing.user_limit : '0' %>" placeholder="0 = unlimited"></div>
          </div>
          <div class="form-row">
            <div class="field"><label>API Limit</label><input type="text" name="api_limit" value="<%= editing ? editing.api_limit : '' %>" placeholder="e.g. 10000/day"></div>
            <div class="field"><label>Trial Days</label><input type="number" name="trial_days" value="<%= editing ? editing.trial_days : '0' %>" placeholder="0 = no trial"></div>
          </div>
          <div class="form-row">
            <div class="field"><label>Status</label>
              <select name="status">
                <option value="active" <%= editing && editing.status === 'active' ? 'selected' : '' %>>Active</option>
                <option value="inactive" <%= editing && editing.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
              </select>
            </div>
            <div class="field"><label>Badge Color</label><input type="color" name="badge_color" value="<%= editing ? editing.badge_color : '#3b82f6' %>"></div>
          </div>
          <div class="form-row">
            <div class="field"><label>Badge Text</label><input type="text" name="badge" value="<%= editing ? editing.badge : '' %>" placeholder="e.g. Popular, Premium"></div>
            <div class="field" style="display:flex;align-items:end;padding-bottom:8px">
              <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                <input type="checkbox" name="popular" value="1" <%= editing && editing.popular ? 'checked' : '' %>> Mark as Popular
              </label>
            </div>
          </div>
          <button class="btn btn-accent" type="submit"><%= editing ? 'Save Changes' : 'Create Plan' %></button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
