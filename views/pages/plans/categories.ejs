<%- include('../../partials/head', { title: 'Plan Categories' }) %>

<% if (query && query.saved) { %><div class="alert alert-success">Category saved.</div><% } %>
<% if (query && query.deleted) { %><div class="alert alert-success">Category deleted.</div><% } %>
<% if (query && query.error) { %><div class="alert alert-error"><%= query.error %></div><% } %>

<div class="row">
  <div class="col-5">
    <div class="card">
      <div class="card-head"><h2><svg class="ic"><use href="#i-plus"/></svg> <%= editing ? 'Edit Category' : 'Add Category' %></h2></div>
      <div class="card-body">
        <form method="POST" action="<%= editing ? '/plans/categories/' + editing.id + '/edit' : '/plans/categories/add' %>" class="form">
          <div class="field"><label>Name *</label><input type="text" name="name" value="<%= editing ? editing.name : '' %>" required placeholder="e.g. Basic, Premium"></div>
          <div class="field"><label>Description</label><input type="text" name="description" value="<%= editing ? editing.description : '' %>" placeholder="Short description"></div>
          <div class="field"><label>Sort Order</label><input type="number" name="sort_order" value="<%= editing ? editing.sort_order : '0' %>"></div>
          <button class="btn btn-accent" type="submit"><%= editing ? 'Save Changes' : 'Add Category' %></button>
          <% if (editing) { %><a class="btn btn-ghost" href="/plans/categories">Cancel</a><% } %>
        </form>
      </div>
    </div>
  </div>
  <div class="col-7">
    <div class="card table-card">
      <div class="card-head"><h2><svg class="ic"><use href="#i-folder"/></svg> All Categories</h2></div>
      <div class="card-body">
        <table>
          <thead><tr><th>Name</th><th>Description</th><th>Plans</th><th>Order</th><th class="ta-r">Actions</th></tr></thead>
          <tbody>
            <% categories.forEach(function(c){ %>
            <tr>
              <td><b><%= c.name %></b></td>
              <td><small style="color:var(--muted)"><%= c.description || '-' %></small></td>
              <td><span class="badge"><%= c.plan_count || 0 %></span></td>
              <td><%= c.sort_order %></td>
              <td class="ta-r">
                <div class="row-actions">
                  <a class="icon-btn" href="/plans/categories?edit=<%= c.id %>" title="Edit"><svg class="ic"><use href="#i-pencil"/></svg></a>
                  <form method="POST" action="/plans/categories/<%= c.id %>/delete" onsubmit="return confirm('Delete this category?')" class="inline">
                    <button class="icon-btn danger" type="submit" title="Delete"><svg class="ic"><use href="#i-trash"/></svg></button>
                  </form>
                </div>
              </td>
            </tr>
            <% }); %>
            <% if (!categories.length) { %>
            <tr><td colspan="5" class="empty">No categories yet. Create one above.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
