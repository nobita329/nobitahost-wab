<%- include('../../partials/head', { title: 'Plans Dashboard' }) %>

<div class="row">
  <div class="col-3"><div class="stat-card"><div class="stat-icon blue"><svg class="ic"><use href="#i-folder"/></svg></div><div class="stat-meta"><h3><%= stats.totalPlans %></h3><p>Total Plans</p></div></div></div>
  <div class="col-3"><div class="stat-card"><div class="stat-icon green"><svg class="ic"><use href="#i-shield"/></svg></div><div class="stat-meta"><h3><%= stats.activePlans %></h3><p>Active Plans</p></div></div></div>
  <div class="col-3"><div class="stat-card"><div class="stat-icon gold"><svg class="ic"><use href="#i-users"/></svg></div><div class="stat-meta"><h3><%= stats.totalSubscribers %></h3><p>Total Subscribers</p></div></div></div>
  <div class="col-3"><div class="stat-card"><div class="stat-icon purple"><svg class="ic"><use href="#i-chart"/></svg></div><div class="stat-meta"><h3><%= settings.plan_currency || '$' %><%= stats.monthlyRevenue.toFixed(2) %></h3><p>Monthly Revenue</p></div></div></div>
</div>

<div class="row" style="margin-top:16px">
  <div class="col-6">
    <div class="card">
      <div class="card-head"><h2><svg class="ic"><use href="#i-chart"/></svg> Recent Transactions</h2></div>
      <div class="card-body">
        <% if (recentTransactions.length) { %>
        <table>
          <thead><tr><th>User</th><th>Plan</th><th>Amount</th><th>Date</th></tr></thead>
          <tbody>
            <% recentTransactions.forEach(function(t){ %>
            <tr>
              <td><%= t.username || '-' %></td>
              <td><span class="badge"><%= t.plan_name %></span></td>
              <td><%= settings.plan_currency || '$' %><%= t.total.toFixed(2) %></td>
              <td><small style="color:var(--muted)"><%= t.created_at %></small></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
        <% } else { %><div class="empty">No transactions yet.</div><% } %>
      </div>
    </div>
  </div>
  <div class="col-6">
    <div class="card">
      <div class="card-head"><h2><svg class="ic"><use href="#i-info"/></svg> Quick Stats</h2></div>
      <div class="card-body">
        <div style="display:flex;flex-direction:column;gap:12px">
          <div style="display:flex;justify-content:space-between"><span>Active Subscribers</span><b><%= stats.activeSubscribers %></b></div>
          <div style="display:flex;justify-content:space-between"><span>Expired Subscriptions</span><b><%= stats.expiredSubscriptions %></b></div>
          <div style="display:flex;justify-content:space-between"><span>Total Coupons</span><b><%= stats.totalCoupons %></b></div>
          <div style="display:flex;justify-content:space-between"><span>Active Coupons</span><b><%= stats.activeCoupons %></b></div>
          <div style="display:flex;justify-content:space-between"><span>Total Revenue</span><b><%= settings.plan_currency || '$' %><%= stats.totalRevenue.toFixed(2) %></b></div>
        </div>
        <div style="margin-top:16px;display:flex;gap:8px">
          <a class="btn btn-accent btn-sm" href="/plans/add">Add Plan</a>
          <a class="btn btn-ghost btn-sm" href="/plans/all">View All Plans</a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
