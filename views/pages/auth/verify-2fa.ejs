<%- include('../../partials/auth-head', { title: 'Two-Factor Auth' }) %>
<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-brand">
      <% if (settings.logo_type === 'url' && settings.logo_url) { %>
        <img src="<%= settings.logo_url %>" alt="logo">
      <% } else { %>
        <span class="brand-logo brand-emoji lg"><%= settings.logo_emoji %></span>
      <% } %>
      <h1>Two-Factor Auth</h1>
      <p>Enter the 6-digit code from your authenticator app</p>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="POST" action="/verify-2fa" class="form">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field">
        <input class="otp-input" type="text" name="code" placeholder="000000" maxlength="6" inputmode="numeric" required autofocus>
      </div>
      <button class="btn btn-accent btn-block" type="submit">Verify</button>
    </form>

    <div class="auth-links"><a href="/logout">Back to login</a></div>
  </div>
</div>
<script src="/js/app.js"></script>
<script>window.__NH_EXTRAS = { cookieBanner: <%= settings.cookie_banner === 'on' ? 'true' : 'false' %>, antiAdblock: <%= settings.anti_adblock === 'on' ? 'true' : 'false' %> };</script>
<script src="/js/extras.js"></script>
<% if (settings.inject_body_code) { %><%- settings.inject_body_code %><% } %>
</body>
</html>
