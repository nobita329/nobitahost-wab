<%- include('../../partials/auth-head', { title: 'Forgot Password' }) %>
<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-brand">
      <% if (settings.logo_type === 'url' && settings.logo_url) { %>
        <img src="<%= settings.logo_url %>" alt="logo">
      <% } else { %>
        <span class="brand-logo brand-emoji lg"><%= settings.logo_emoji %></span>
      <% } %>
      <h1>Forgot Password</h1>
      <p>We'll email you a reset link</p>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <form method="POST" action="/forgot" class="form">
      <div class="field">
        <label>Email</label>
        <input type="email" name="email" placeholder="you@example.com" required autofocus>
      </div>
      <button class="btn btn-accent btn-block" type="submit">Send Reset Link</button>
    </form>

    <div class="auth-links"><a href="/login">Back to login</a></div>
  </div>
</div>
<script src="/js/app.js"></script>
<script>window.__NH_EXTRAS = { cookieBanner: <%= settings.cookie_banner === 'on' ? 'true' : 'false' %>, antiAdblock: <%= settings.anti_adblock === 'on' ? 'true' : 'false' %> };</script>
<script src="/js/extras.js"></script>
<% if (settings.inject_body_code) { %><%- settings.inject_body_code %><% } %>
</body>
</html>
