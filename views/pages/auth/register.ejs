<%- include('../../partials/auth-head', { title: 'Register' }) %>
<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-brand">
      <% if (settings.logo_type === 'url' && settings.logo_url) { %>
        <img src="<%= settings.logo_url %>" alt="logo">
      <% } else { %>
        <span class="brand-logo brand-emoji lg"><%= settings.logo_emoji %></span>
      <% } %>
      <h1>Create Account</h1>
      <p>Join <%= settings.panel_name %></p>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %> <a href="/login">Login now</a></div><% } %>

    <form method="POST" action="/register" class="form">
      <div class="field">
        <label>Username</label>
        <input type="text" name="username" placeholder="Choose a username" required autofocus>
      </div>
      <div class="field">
        <label>Email</label>
        <input type="email" name="email" placeholder="you@example.com" required>
      </div>
      <div class="field">
        <label>Password</label>
        <div class="pass-wrap">
          <input type="password" name="password" placeholder="Min 6 characters" required>
          <button type="button" class="pass-toggle" tabindex="-1">Show</button>
        </div>
      </div>
      <div class="field">
        <label>Confirm Password</label>
        <input type="password" name="confirm" placeholder="Repeat password" required>
      </div>
      <button class="btn btn-accent btn-block" type="submit">Register</button>
    </form>

    <div class="auth-links">
      <span>Already have an account?</span> <a href="/login">Login</a>
    </div>
  </div>
</div>
<script src="/js/app.js"></script>
</body>
</html>
