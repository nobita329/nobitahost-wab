    </main>
  </div>
</div>

<% if (settings.music_type !== 'none' && settings.music_url) { %>
<div class="music-widget" id="musicWidget">
  <button class="icon-btn" id="musicToggle" aria-label="Music"><svg class="ic"><use href="#i-music"/></svg></button>
  <% if (settings.music_type === 'youtube' && /(youtu\.be|youtube\.com)/.test(settings.music_url)) { %>
    <% var vid = settings.music_url.match(/(?:v=|youtu\.be\/|\/embed\/)([\w-]{6,})/); %>
    <iframe class="music-frame" src="https://www.youtube.com/embed/<%= vid ? vid[1] : '' %>?enablejsapi=1&rel=0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
  <% } else { %>
    <audio id="musicPlayer" src="<%= settings.music_url %>" loop preload="none"></audio>
  <% } %>
  <span class="music-tip" id="musicTip">Play music</span>
</div>
<% } %>

<div class="toasts" id="toasts"></div>

