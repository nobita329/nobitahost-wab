<!DOCTYPE html>
<html lang="en" data-theme="<%= settings.theme || 'dark' %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title ? title + ' · ' : '' %><%= settings.panel_name %></title>
<link rel="icon" href="<%= settings.favicon_url || '/img/favicon.svg' %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Figtree:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/lucentui.css">
<script>
  try {
    var m = localStorage.getItem('lucent-mode');
    if (m) document.documentElement.setAttribute('data-theme', m);
  } catch (e) {}
</script>
<style>
  :root { --accent: <%= settings.accent_color || '#3b82f6' %>; --card-radius: <%= (settings.card_radius || '16') %>px; --glass: <%= normalizeBlur(settings) %>px; --overlay: <%= overlayAlpha(settings) %>; }
</style>
</head>
<body class="<%= [bodyClass, settings.transparent_bar === 'on' ? 'bar-transparent' : '', settings.blur_bar === 'on' ? 'bar-blur' : ''].filter(Boolean).join(' ') %>">
<%
  var bgUrl = (bg && bg.url) || '';
  var bgType = (bg && bg.type) || 'image';
%>
<div class="bg-layer">
  <% if (bgUrl && bgType === 'video') { %>
    <video autoplay muted loop playsinline><source src="<%= bgUrl %>" type="video/mp4">Your browser does not support video.</video>
  <% } else if (bgUrl) { %>
    <div class="bg-img" style="background-image:url('<%= bgUrl %>')"></div>
  <% } else { %>
    <div class="bg-img bg-gradient"></div>
  <% } %>
  <div class="bg-overlay"></div>
</div>

<div class="app">
  <%- include('sidebar') %>
  <div class="main">
    <%- include('topbar') %>
    <main class="content">
